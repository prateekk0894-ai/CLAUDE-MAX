# Images:
#   manual       free, best looking: copy the prompt, make the photo in Gemini, upload it here
#   pollinations free and automatic, but low quality (does not look like a real person)
#   replicate    paid, automatic, same face every time
#   mock         placeholders for testing
IMAGE_PROVIDER=manual

# Captions: "pollinations" (free, no key) or "claude" (paid).
CAPTION_PROVIDER=pollinations

# Only for IMAGE_PROVIDER=replicate
REPLICATE_API_TOKEN=
# REPLICATE_BASE_MODEL=black-forest-labs/flux-1.1-pro
# REPLICATE_EDIT_MODEL=black-forest-labs/flux-kontext-pro

# Only for CAPTION_PROVIDER=claude
ANTHROPIC_API_KEY=

PORT=4321
